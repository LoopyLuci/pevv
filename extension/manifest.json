{
  "manifest_version": 3,
  "name": "PEVV",
  "short_name": "PEVV",
  "description": "PEVV password vault: fill, save and generate logins from the same encrypted vault as the web app and the desktop app.",
  "version": "0.2.1",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "PEVV",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "background": { "service_worker": "worker.js", "type": "module" },
  "permissions": ["activeTab", "storage", "scripting", "idle", "alarms"],
  "optional_permissions": ["nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
