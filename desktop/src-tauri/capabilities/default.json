{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The PEVV window: its own commands, and listening for events. Nothing else (no fs, shell, http, opener).",
  "windows": ["main"],
  "permissions": [
    "allow-vault-read",
    "allow-vault-write",
    "allow-vault-clear",
    "allow-clipboard-copy",
    "allow-passkey-support",
    "allow-passkey-prf",
    "allow-usb-volumes",
    "allow-usb-keyfile-read",
    "allow-usb-keyfile-write",
    "allow-usb-devices",
    "allow-presence-get",
    "allow-presence-set",
    "allow-link-state",
    "allow-link-set-enabled",
    "allow-link-unpair",
    "allow-link-prompts",
    "allow-link-prompt-answer",
    "allow-link-respond",
    "allow-link-report-state",
    "allow-cli-state",
    "allow-cli-prompts",
    "allow-cli-prompt-answer",
    "allow-cli-revoke-client",
    "allow-cli-revoke-command",
    "allow-autotype-support",
    "allow-autotype-settings-get",
    "allow-autotype-settings-set",
    "allow-autotype-offer",
    "allow-autotype-type",
    "allow-autotype-finish",
    "allow-autotype-mode",
    "allow-passkey-provider-support",
    "allow-passkey-provider-register",
    "allow-passkey-provider-unregister",
    "allow-passkey-provider-respond",
    "allow-passkey-provider-sync",
    "allow-update-enabled",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
