# Copy to .env.local (git-ignored). Everything is optional: with nothing set PEVV is fully local, with no network access.
# These are read at BUILD time (see docs/SYNC_SELF_HOSTING.md).

# Optional sync + vault-QR relay: your own Supabase project. Use the anon (public) key only. NEVER the service-role key.
VITE_PEVV_SYNC_URL=
VITE_PEVV_SYNC_ANON_KEY=

# Optional: public https address of your hosted web app (used in vault-QR links shown by the extension / desktop app).
VITE_PEVV_PUBLIC_URL=

# Optional: serve the web app from a sub-path (default "/").
# VITE_PEVV_BASE=/pevv/

# Desktop shell (read by cargo / tauri build, not Vite): host name of your web app, for passkey unlock in the desktop app.
# PEVV_RP_ID=pevv.example.com
