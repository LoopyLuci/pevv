<?xml version="1.0" encoding="utf-8"?>
<!-- Everything the app talks to is HTTPS or WSS. Clear text is off for every host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
